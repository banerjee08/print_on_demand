      "type": "n8n-nodes-base.html",
      "position": [
        660,
        80
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "model": "llama3.2:latest",
        "options": {
          "temperature": 0,
          "numPredict": 4000
        }
      },
      "id": "03166ed2-f387-44dd-8bc8-b8f0fb91476b",
      "name": "Ollama Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "position": [
        972,
        304
      ],
      "typeVersion": 1,
      "alwaysOutputData": true,
      "credentials": {
        "ollamaApi": {
          "id": "lhvQJmJDNIJ4CYLu",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "text": "={{ $json.content }}",
        "attributes": {
          "attributes": [
            {
              "name": "date",
              "type": "date",
              "description": "Exact date from the page (e.g., \"January 1\")."
            },
            {
              "name": "event_name",
              "description": "Exact event name from the page (e.g., \"New Year’s Day\")."
            },
            {
              "name": "product_ideas",
              "description": "Exact product recommendations from the page under that event/month (comma-separated; \"none\" if absent)."
            },
            {
              "name": "design_ideas",
              "description": "2–3 VERY SHORT design concepts DIRECTLY inspired by the event description on THIS PAGE ONLY (e.g., \"hearts, roses\" for romance; comma-separated; \"none\" if unclear). NO inventions."
            }
          ]
        },
        "options": {
          "systemMessage": "={{ 'IMPORTANT OUTPUT RULES: Respond ONLY with a JSON ARRAY of objects. NO intro text, NO markdown, NO code blocks, NO explanations. Just: [{\"date\": \"...\", \"event_name\": \"...\", \"product_ideas\": \"...\", \"design_ideas\": \"...\"}, ...]\\n\\nStrict extractor for Printify eCommerce calendar. ONLY use input HTML text.\\n\\nEXTRACT EVENTS ONLY FOR THE MONTH OF ' + $json.nextMonth.toUpperCase() + '. Ignore any events from other months.\\n\\nFor each event in ' + $json.nextMonth + ':\\n- date: Copy exactly (e.g., \"' + $json.nextMonth.substring(0,3) + ' 14\").\\n- event_name: Copy exactly.\\n- product_ideas: Copy ONLY \"Product recommendations\" bullets verbatim (comma-sep; \"none\" if absent).\\n- design_ideas: 2-3 one-word concepts from page description ONLY (e.g., \"hearts, roses\"; \"none\" otherwise).\\n\\nExamples (do not include): [{\"date\": \"Feb 14\", \"event_name\": \"Valentine’s Day\", \"product_ideas\": \"mugs, hoodies\", \"design_ideas\": \"hearts, couples\"}]' }}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        892,
        80
      ],
      "id": "b56e7fc5-616d-43ae-aeb2-dd8218717949",
      "name": "Information Extractor",
