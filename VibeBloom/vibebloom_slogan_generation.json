        "jsCode": "const event = $('Calculate Count').item.json.event;\nconst month = $('Calculate Count').item.json.month;\nconst date = $('Calculate Count').item.json.date;\nlet pastLessons = \"\";\nif ($json.matches && $json.matches.length > 0) {\n  pastLessons = \"\\n\\nCRITICAL SLOGAN RULES TO AVOID:\\n\";\n  for(const match of $json.matches) {\n     pastLessons += \"- \" + match.metadata.lesson + \"\\n\";\n  }\n}\nreturn [{\n  json: {\n    event: event,\n    month: month,\n    date: date,\n    pastLessons: pastLessons\n  }\n}];"
      },
