    {
      "parameters": {
        "method": "POST",
        "url": "https://ollama.sbanerjee.cloud/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'qwen3:1.7b', stream: false, messages: [ { role: 'user', content: 'You are a QA legal agent checking POD slogans for issues. Review this slogan for copyright/trademark infringement risk and readability: \"' + $json.slogan + '\". If it is completely safe and fine, reply with EXACTLY: \"LGTM\". If there are issues, reply with a short explanation of the problems.' } ] } }}",
        "options": {}
      },
      "id": "8e9bca9f-14c1-419b-a0aa-d2fa4aefc592",
      "name": "Ollama QA Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        180
      ],
      "credentials": {
        "ollamaApi": {
          "id": "ollama_credentials",
          "name": "Ollama local"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json.message.content.trim();\nlet status = 'Needs Revision';\nlet feedback = '';\nif (response === 'LGTM') {\n  status = 'LGTM';\n} else {\n  feedback = response;\n}\nreturn [{ json: { ...$('Split In Batches').item.json, newStatus: status, newFeedback: feedback, rowNumber: $('Split In Batches').item.json.row_number } }];"
      },
      "id": "4e9bca9f-14c1-419b-a0aa-d2fa4aefc588",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        180
      ]
    },
