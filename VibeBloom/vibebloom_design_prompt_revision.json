    {
      "parameters": {
        "jsCode": "\nconst fb = $('Feedback Logic').item.json.feedback || 'General Quality Revision';\nconst oldP = $('Feedback Logic').item.json.design_prompt;\nconst newP = $json.message ? $json.message.content : $json.choices[0].message.content;\nconst lesson = `Mistake Avoidance Rule: Do not generate prompts like: ${oldP}. Reason/QA Feedback: ${fb}. Preferred Output Structure: ${newP}`;\nreturn [{ json: { lesson, newPrompt: newP } }];\n"
      },
