      "parameters": {
        "jsCode": "const event = $('Filter Setup').item.json['event/celebration'];\nlet lgtmCount = 0;\nfor (const row of $input.all()) {\n  if (row.json.event === event && row.json.status === 'LGTM' && (!row.json.slogan || row.json.slogan === '')) {\n    lgtmCount++;\n  }\n}\nreturn [{ json: { lgtmCount, event, month: $('Filter Setup').item.json.month, date: $('Filter Setup').item.json.date } }];"
      },
