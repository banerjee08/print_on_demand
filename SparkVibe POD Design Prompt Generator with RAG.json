    {
      "parameters": {
        "text": "={{ 'You are SparkVibe POD expert. Generate 12 DETAILED graphic design prompts for Midjourney/Flux.\\n\\nContext:\\n- Event: ' + $('Split In Batches').item.json.event + ' (' + $('Split In Batches').item.json.month + ' ' + $('Split In Batches').item.json.date + ')\\n- Products: ' + $('Google Sheets Lookup #1').item.json.mid_tier_product_recommendations + ' + ' + $('Google Sheets Lookup #2').item.json.product_recommendations + '\\n- Brand Guidelines: ' + ($json.text || 'See attached') + '\\n- Learn from past: Improve common failures (avoid busy designs, bad shamrocks)\\n\\nEach prompt MUST include:\\n1. Product type (hoodie/t-shirt/mug)\\n2. SparkVibe style: vibrant mid-tier, Instagram-ready\\n3. Event theme (St. Patrick\\'s: shamrocks, green, lucky)\\n4. 4K, highly detailed, commercial POD mockup\\n\\nJSON array only: [{\\n  \"design_prompt\": \"sparkvibe st patricks hoodie, vibrant green shamrocks... --ar 1:1 --v 6\"\\n}]' }}",
        "options": {}
      },
