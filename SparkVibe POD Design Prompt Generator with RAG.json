        "jsCode": "const newItems = [];\nfor (const item of $input.all()) {\n  for (let i = 0; i < 3; i++) {\n    newItems.push({\n      json: {\n        ...item.json,\n        loop_iteration: i + 1\n      }\n    });\n  }\n}\nreturn newItems;"
