    {
      "parameters": {
        "jsCode": "const newItems = [];\nfor (const item of $input.all()) {\n  const keys = Object.keys(item.json);\n  for (const key of keys) {\n    if (['F', 'G', 'H', 'I', 'J', 'K', 'L'].includes(key) || item.json[key].toString().toLowerCase() === 'yes') {\n      if (item.json[key].toString().toLowerCase() === 'yes') {\n        newItems.push({\n          json: {\n            ...item.json,\n            event: key,\n            column_name: key\n          }\n        });\n      }\n    }\n  }\n}\nreturn newItems;"
      },
