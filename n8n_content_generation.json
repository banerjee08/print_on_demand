      "parameters": {
        "jsCode": "const newItems = [];\nlet itemIndex = 0;\n\n// Get data from previous nodes\n// $items('Node Name') gets the items output by that node\nconst ifEmptyItems = $items('If Empty');\nconst productRecItems = $items('Getting info : Product Recommendation');\n\nfor (const item of $input.all()) {\n  // In a straight flow (one item per record), indexes should match up.\n  const baseInfo = ifEmptyItems[itemIndex] ? ifEmptyItems[itemIndex].json : {};\n  const productInfo = productRecItems[itemIndex] ? productRecItems[itemIndex].json : {};\n  \n  for (let i = 0; i < 3; i++) {\n    newItems.push({\n      json: Object.assign({}, item.json, baseInfo, productInfo, { loop_iteration: i + 1 }),\n      pairedItem: { item: itemIndex }\n    });\n  }\n  itemIndex++;\n}\nreturn newItems;"
      },
