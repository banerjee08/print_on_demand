    {
      "parameters": {
        "jsCode": "const newItems = [];\nlet idx = 0;\nfor (const item of $input.all()) {\n  try {\n    let outputText = item.json.output || item.json.text || '';\n    \n    // Extract JSON from code fences: handles ```json, ```, or no fence\n    if (outputText.includes('```json')) {\n      outputText = outputText.split('```json')[1].split('```')[0];\n    } else if (outputText.includes('```')) {\n      // Plain backtick block (e.g. qwen2.5 output style)\n      outputText = outputText.split('```')[1].split('```')[0];\n    } else {\n      // No code fences - try to find a JSON array anywhere in the text\n      const match = outputText.match(/\\[\\s*\\{[\\s\\S]*?\\}\\s*\\]/);\n      if (match) outputText = match[0];\n    }\n    \n    let prompts = [];\n    try {\n      prompts = JSON.parse(outputText.trim());\n    } catch (e) {\n      if (outputText.trim().startsWith('[')) {\n        prompts = JSON.parse(outputText.trim() + ']'); // naive fallback\n      }\n    }\n    \n    // ensure array\n    if (!Array.isArray(prompts)) prompts = [prompts];\n    \n    for (const p of prompts) {\n      if (!p || !p.design_prompt) continue;\n      newItems.push({\n        json: Object.assign({}, item.json, { design_prompt: p.design_prompt }),\n        pairedItem: { item: idx }\n      });\n    }\n  } catch(e) {\n    newItems.push({ \n      json: Object.assign({}, item.json, { error: 'Failed to process AI array', raw_output: item.json }),\n      pairedItem: { item: idx }\n    });\n  }\n  idx++;\n}\nreturn newItems;"
      },
