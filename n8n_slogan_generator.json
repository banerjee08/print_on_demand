    },
    {
      "parameters": {
        "jsCode": "// Build regeneration prompt using rejection context\nconst loopItem = $('Split: Loop Regeneration').item.json;\nlet history = [];\ntry {\n  const raw = $('Supabase: Get This Keyword\\'s History').item.json;\n  history = Array.isArray(raw) ? raw : [];\n} catch(e) { history = []; }\n\nconst rejected = history.filter(h => h.signal_type === 'slogan_rejected').map(h => `✗ \"${h.content || ''}\"`).join('\\n');\nconst approved = history.filter(h => h.signal_type === 'slogan_approved').map(h => `✓ \"${h.content || ''}\"`).join('\\n');\n\nconst systemPrompt = `You are a creative copywriter for POD merchandise (US market).\nGenerate a FRESH batch of 15-20 slogans for the brand and niche below.\nThis is iteration ${loopItem.next_iteration} — the user wants NEW IDEAS.\n\n${rejected ? 'PREVIOUSLY REJECTED (do NOT repeat or sound similar to these):\\n' + rejected : ''}\n${approved ? 'APPROVED STYLE (this person likes these — emulate the tone):\\n' + approved : ''}\n\nBe more creative, unexpected, and different from previous batches.\nSlogans must be max 6 words, print-ready, original.\n\nOutput ONLY valid JSON:\n{ \"slogans\": [\"Slogan 1\", ...] }`;\n\nconst userPrompt = `Brand: ${loopItem.brand}\\nKeyword: \"${loopItem.keyword}\"\\nEvent: ${loopItem.event_name || 'N/A'}\\n\\nGenerate 15-20 fresh slogans.`;\n\nreturn [{ json: { ...loopItem, ollama_messages: [{role:'system',content:systemPrompt},{role:'user',content:userPrompt}] } }];"
      },
