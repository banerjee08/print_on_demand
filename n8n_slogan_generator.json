        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3.2:3b', messages: $json.ollama_messages, stream: false, options: { temperature: 0.8, num_predict: 1200 } }) }}",
        "options": {"timeout": 120000}
      },
      "id": "b1000000-0002-0002-0002-000000000010",
      "name": "Ollama: Generate Slogans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse Ollama slogan response — expand to one row per slogan\nconst loopItem = $('Code: Build Slogan Prompt').item.json;\nconst rawText = $input.item.json?.message?.content || $input.item.json?.response || '';\n\nlet parsed = { brand_fit_score: 5, brand_fit_reasoning: 'Error parsing', proceed: false, slogans: [] };\ntry {\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {\n  parsed.brand_fit_reasoning = rawText.slice(0, 200);\n}\n\n// If brand fit too low, skip\nif (!parsed.proceed || parsed.brand_fit_score < 6) {\n  return [{json: {\n    _skip: true,\n    brand: loopItem.brand,\n    keyword: loopItem.keyword,\n    brand_fit_score: parsed.brand_fit_score,\n    brand_fit_reasoning: parsed.brand_fit_reasoning,\n    message: 'Brand fit too low — skipped'\n  }}];\n}\n\n// One row per slogan (15-20 rows)\nconst slogans = (parsed.slogans || []).slice(0, 20);\nreturn slogans.map((slogan, i) => ({\n  json: {\n    brand: loopItem.brand,\n    keyword: loopItem.keyword,\n    event_name: loopItem.event_name || '',\n    brand_niche: loopItem.brand_niche || '',\n    slogan_idea: slogan,\n    brand_fit_score: parsed.brand_fit_score,\n    brand_fit_reasoning: i === 0 ? parsed.brand_fit_reasoning : '',\n    run_date: loopItem.run_date || new Date().toISOString().split('T')[0],\n    status: 'Awaiting Approval',\n    iteration: 1\n  }\n}));"
      },
