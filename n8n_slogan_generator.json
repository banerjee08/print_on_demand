      "parameters": {
        "jsCode": "// Expand: one item per brand per approved keyword\nconst approvedRow = $input.item.json;\nconst brandsStr = approvedRow.applicable_brands || '';\nconst brands = brandsStr.split(',').map(b => b.trim()).filter(Boolean);\n\nif (brands.length === 0) {\n  // Fallback: all brands\n  return ['SparkVibe','VibeBloom','PulsePlay','ScribbleSpark','PawPop','GlowGiggle','TinyGiggle']\n    .map(brand => ({json: {...approvedRow, brand}}));\n}\n\nreturn brands.map(brand => ({json: {...approvedRow, brand}}));"
      },
