        "jsCode": "// Parse regenerated slogans\nconst loopItem = $('Code: Build Regen Prompt').item.json;\nconst rawText = $input.item.json?.message?.content || '';\n\nlet slogans = [];\ntry {\n  const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    slogans = parsed.slogans || [];\n  }\n} catch(e) { slogans = []; }\n\nconst nextIteration = loopItem.next_iteration || 2;\n\nreturn slogans.slice(0, 20).map(slogan => ({\n  json: {\n    brand: loopItem.brand,\n    keyword: loopItem.keyword,\n    event_name: loopItem.event_name || '',\n    slogan_idea: slogan,\n    brand_fit_score: '',\n    brand_fit_reasoning: `Regeneration batch ${nextIteration}`,\n    run_date: new Date().toISOString().split('T')[0],\n    status: 'Awaiting Approval',\n    iteration: nextIteration\n  }\n}));"
      },
