    {
      "parameters": {
        "jsCode": "// Deduplicate: get unique brand+keyword pairs that need more slogans\nconst rows = $input.all();\nconst seen = new Set();\nconst uniquePairs = [];\n\nfor (const row of rows) {\n  const key = `${row.json.brand}||${row.json.keyword}`;\n  if (!seen.has(key)) {\n    seen.add(key);\n    // Get iteration count to know which loop this is\n    const maxIteration = Math.max(...rows\n      .filter(r => r.json.brand === row.json.brand && r.json.keyword === row.json.keyword)\n      .map(r => parseInt(r.json.iteration) || 1));\n    uniquePairs.push({json: {\n      brand: row.json.brand,\n      keyword: row.json.keyword,\n      event_name: row.json.event_name || '',\n      brand_niche: row.json.brand_niche || '',\n      interest_score_7d: row.json.interest_score_7d || 0,\n      interest_score_3m: row.json.interest_score_3m || 0,\n      interest_score_1yr: row.json.interest_score_1yr || 0,\n      next_iteration: maxIteration + 1,\n      run_date: new Date().toISOString().split('T')[0],\n      is_regeneration: true\n    }});\n  }\n}\n\nreturn uniquePairs;"
      },
