      "id": "b1000000-0002-0002-0002-000000000008",
      "name": "Supabase: Get Slogan Prefs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, 520]
    },
    {
      "parameters": {
        "jsCode": "// Build brand fit check + slogan generation prompt\nconst loopItem = $('Split: Loop Per Brand×Keyword').item.json;\nconst brandName = loopItem.brand;\n\n// Parse brand guidelines — find rows for this brand\nconst guidelineRows = $('GSheets: Read Brand Guidelines').all();\nlet brandGuideline = 'No specific guidelines found — use a fun, modern, US market tone.';\nfor (const row of guidelineRows) {\n  const vals = Object.values(row.json || {});\n  if (vals.some(v => String(v).toLowerCase().includes(brandName.toLowerCase()))) {\n    brandGuideline = Object.entries(row.json)\n      .map(([k, v]) => `${k}: ${v}`).join(' | ');\n    break;\n  }\n}\n\n// Parse slogan preferences (handles empty gracefully)\nlet prefSignals = [];\ntry {\n  const raw = $('Supabase: Get Slogan Prefs').item.json;\n  prefSignals = Array.isArray(raw) ? raw : [];\n} catch(e) { prefSignals = []; }\n\nconst approvedSlogans = prefSignals.filter(p => p.signal_type === 'slogan_approved').map(p => `✓ \"${p.content}\" (${p.niche_keyword})`).slice(0, 5).join('\\n');\nconst rejectedSlogans = prefSignals.filter(p => p.signal_type === 'slogan_rejected').map(p => `✗ \"${p.content}\" (${p.niche_keyword})`).slice(0, 5).join('\\n');\n\nconst systemPrompt = `You are a creative copywriter specializing in POD (Print-on-Demand) merchandise for the US market.\n\nBRAND: ${brandName}\nBRAND GUIDELINES: ${brandGuideline}\n\nTASK:\n1. First, assess brand fit (1-3 sentences): Does the niche suit ${brandName}? Will products look authentic or forced?\n2. If brand fit score >= 6/10, generate EXACTLY 15-20 short, punchy slogans for the niche.\n\nSLOGAN RULES:\n- Max 6 words each\n- Original — no copyrighted phrases\n- Match brand voice (fun/edgy/warm based on brand)\n- Optimized for US Gen Z / Millennials\n- Print-ready (looks good on a tee from a distance)\n- Variety: mix humor, emotion, boldness, wit\n\n${approvedSlogans ? 'APPROVED STYLE EXAMPLES (emulate these):\\n' + approvedSlogans : ''}\n${rejectedSlogans ? 'REJECTED PATTERNS (avoid these):\\n' + rejectedSlogans : ''}\n\nOUTPUT FORMAT — valid JSON only:\n{\n  \"brand_fit_score\": 8,\n  \"brand_fit_reasoning\": \"...\",\n  \"proceed\": true,\n  \"slogans\": [\"Slogan 1\", \"Slogan 2\", ...]\n}`;\n\nconst userPrompt = `Niche/Keyword: \"${loopItem.keyword}\"\nEvent: ${loopItem.event_name || 'N/A'}\nTrend interest: 7d=${loopItem.interest_score_7d}, 3mo=${loopItem.interest_score_3m}, 1yr=${loopItem.interest_score_1yr}\n\nGenerate brand fit assessment and 15-20 slogans.`;\n\nreturn [{\n  json: {\n    ...loopItem,\n    brand_guideline: brandGuideline,\n    ollama_messages: [\n      {role: 'system', content: systemPrompt},\n      {role: 'user', content: userPrompt}\n    ]\n  }\n}];"
      },
      "id": "b1000000-0002-0002-0002-000000000009",
      "name": "Code: Build Slogan Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 400]
